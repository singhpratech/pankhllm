{
  "name": "pankhllm",
  "version": "0.1.0",
  "description": "The LLM gateway that learns to skip the LLM: trains its own tiny decision model on your agent's traffic and answers repeat decisions in 0.2 ms with no LLM call. OpenAI-compatible, one Rust binary. `npx pankhllm serve`.",
  "bin": { "pankhllm": "bin/pankhllm.js" },
  "files": ["bin"],
  "optionalDependencies": {
    "@pankhllm/linux-x64": "0.1.0",
    "@pankhllm/linux-arm64": "0.1.0",
    "@pankhllm/darwin-x64": "0.1.0",
    "@pankhllm/darwin-arm64": "0.1.0",
    "@pankhllm/win32-x64": "0.1.0"
  },
  "engines": { "node": ">=18" },
  "homepage": "https://singhpratech.github.io/pankhllm/",
  "repository": { "type": "git", "url": "https://github.com/singhpratech/pankhllm.git", "directory": "packaging/npm/pankhllm" },
  "keywords": ["llm", "gateway", "router", "openai", "agents"],
  "license": "MIT"
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Pankhllm</PackageId>
    <Version>0.1.1</Version>
    <Description>Client for pankhllm, the LLM gateway that learns to skip the LLM. Client and planner-lane executor.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://singhpratech.github.io/pankhllm/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/singhpratech/pankhllm</RepositoryUrl>
    <PackageTags>llm;gateway;router;openai;agents</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
